{
  "name": "project-mosaic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "validate:content": "node scripts/validate-content.mjs",
    "test:progress": "node --test scripts/learning-progress.test.mjs",
