    "test:session": "node --test scripts/study-session.test.mjs",
    "test:auth": "node --test scripts/auth-config.test.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "swiper": "14.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "sass": "1.105.1",
    "typescript": "6.0.3"
  }
