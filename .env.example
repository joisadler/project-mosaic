# Guest browsing works with no environment file. Copy to .env.local to enable auth.
# Never commit real credentials. Restart Next.js after changing these values.
MOSAIC_AUTH_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=
MONGODB_DB_NAME=project_mosaic_dev
# Optional fixed HTTPS tunnel origin, without a path or trailing slash.
# Register its /api/auth/callback/google URL in the development OAuth client.
AUTH_DEV_ORIGIN=
